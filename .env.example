# Postgres. One database per app, as everywhere else in the stack.
DATABASE_URL=postgres://rr:password@localhost:5432/rr_crown
PG_POOL_MAX=10

# Redis: live leaderboard + presence. Optional for phases 1-2 (solo).
REDIS_URL=redis://localhost:6379

# Session signing. `openssl rand -hex 32`. NEVER commit the real value.
JWT_SIGNING_SECRET=

# WS server
WS_PORT=3010
# Sharding — leave at 1 until one process actually stops keeping up.
WS_SHARDS=1
WS_SHARD_ID=0

# What the browser connects to.
NEXT_PUBLIC_WS_URL=http://localhost:3010

# ── USDC payments (the shop's money route) ───────────────────────────────────
# All three must be set, or the shop serves carrots only and hides the USDC
# buttons. There is deliberately NO default: a hardcoded mainnet address is how
# a test build takes real money.
#
# Where item payments are received. An ordinary Solana wallet you control — its
# USDC associated token account is created by the first payment.
USDC_TREASURY_ADDRESS=
# The USDC mint for the network you point at. The mint address is the only real
# name a token has; any SPL token can call itself "USDC".
#   mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
#   devnet:  4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_MINT=
# RPC endpoint. Also served to the browser (see api/config) so the wallet can
# build the transfer.
SOLANA_RPC_URL=https://api.devnet.solana.com
