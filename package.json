{
  "name": "rabbit-royale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "higgsfield:example": "bun --env-file=.env.local run examples/higgsfield/index.ts",
    "ws": "bun run server/index.ts",
    "ws:dev": "bun --watch run server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "bun run scripts/check-migrations.ts",
    "db:seed-tuning": "bun run scripts/seed-tuning.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@higgsfield/client": "^0.2.6",
    "@metaplex-foundation/mpl-core": "1.10.0",
    "@metaplex-foundation/umi": "1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "1.6.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "redis": "^5.12.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "type": "module"
}
