{
  "name": "rabbit-royale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "higgsfield:example": "bun --env-file=.env.local run examples/higgsfield/index.ts",
    "dev": "vite --port 3010",
    "build": "vite build",
    "start": "vite preview --port 3010",
    "ws": "bun run server/index.ts",
    "ws:dev": "bun --watch run server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "db:check": "bun run scripts/check-migrations.ts",
    "db:seed-tuning": "bun run scripts/seed-tuning.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@domin8/arcade-kit": "github:Paul-Ollivier/arcade-kit#v2.2.1",
    "@higgsfield/client": "^0.2.6",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.1",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "jose": "^6.2.3",
    "pixi.js": "^8.20.1",
    "postgres": "^3.4.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "^5.10.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "typescript": "^5",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  },
  "type": "module"
}
