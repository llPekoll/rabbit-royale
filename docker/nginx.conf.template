# DEUX SITES, UN CONTENEUR (2026-10-19), choisis par le nom d'hote.
#
#   rabbit.rip, www.rabbit.rip  -> la VITRINE du web2 (site/) : fiches Google
#                                  Play et App Store, pubs, presse. Rien n'y
#                                  parle de crypto ni ne mene au web3.
#   tout le reste               -> le site du WEB3 (landing/ + le jeu sous
#                                  /play/) : sol.rabbit.rip, stage-sol.rabbit.rip,
#                                  localhost. C'est l'ancien rabbit.rip, tel quel.
#                                  web3.rabbit.rip (son premier nom, 19/10)
#                                  le sert toujours, tel quel.
#
# POURQUOI DEUX SITES : rabbit.rip est l'adresse des fiches Google Play et
# App Store, de la presse et des pubs. Apple interdit hors des Etats-Unis que
# l'app et ses metadonnees menent a un achat hors de son systeme (3.1.1(a)),
# Google Play aussi (sa politique de paiement compte la fiche). Le web3 vend
# en crypto : la vitrine ne le nomme ni ne le lie jamais, meme dans un
# commentaire HTML (site/ est lu tel quel par qui ouvre le code source).
#
# La vitrine garde trois chemins du web3, pour les coques Seeker deja
# installees qui les ont en dur (godot/scripts/boot.gd, book_voice.gd) :
# /play/android/ (le pack), /play/voice/ (la voix des livres) et les
# fichiers Firebase de /play/ (un ancien abonnement aux notifications). Le
# reste de /play/ est le jeu WEB2 depuis le 2026-10-30 (avant : une page de
# passage) ; site/play/move.js y conduit encore un terrier d'avant.

server {
  listen 3010 default_server;
  root /usr/share/nginx/html/web3;
  index index.html;

  # LE CLIENT GODOT, COMPRESSE ET REVALIDE.
  #
  # L'export porte ~29 Mo (index.wasm 22,6 : moteur allege, voir
  # godot/web/engine.gdbuild ; index.pck 6,4) : gzip les ramene a ~12. Les
  # gros sont COMPRESSES AU BUILD (Dockerfile, `.gz` a
  # cote) et servis tels quels par gzip_static : recompresser 23 Mo a chaque
  # visite prendrait une seconde de CPU. Le reste l'est a la volee.
  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_types application/wasm application/octet-stream application/javascript text/css application/json image/svg+xml;

  # Les noms de l'export ne changent JAMAIS (index.wasm, index.pck, index.js) :
  # un cache long garderait l'ancien jeu apres un deploiement. On laisse le
  # navigateur garder les octets mais il redemande a chaque chargement ; un
  # 304 sur l'ETag ne coute qu'un aller-retour.
  location ~ ^/play/index\.(wasm|pck|js|audio\.worklet\.js|audio\.position\.worklet\.js)$ {
    types {
      application/wasm wasm;
      application/octet-stream pck;
      application/javascript js;
    }
    gzip_static on;
    add_header Cache-Control "no-cache";
  }

  # LE JEU ANDROID (godot/scripts/boot.gd). Le manifeste est relu a chaque
  # lancement : jamais en cache, sinon un deploiement n'atteint pas les
  # telephones. Le pack porte son hash dans son nom : il ne change jamais.
  location = /play/android/manifest.json {
    types { application/json json; }
    add_header Cache-Control "no-cache";
  }
  location ~ "^/play/android/game-[0-9a-f]{64}\.pck$" {
    types { application/octet-stream pck; }
    # Textures deja compressees : gzip -9 n'y gagne que 5 %, pour 18 Mo a
    # recompresser a chaque telechargement.
    gzip off;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  # FIREBASE, A COTE DU JEU : la config web et le worker des notifications
  # (godot/web/, copies par le Dockerfile). JAMAIS en cache long : un worker
  # perime continue d'intercepter les clics sur les notifications avec son
  # ancien code, et une config perimee enverrait les evenements a l'ancien
  # projet. Le navigateur revalide le worker de lui-meme a chaque
  # navigation, mais seulement si le serveur ne lui promet pas de le garder.
  location ~ ^/play/(firebase-messaging-sw|firebase-config)\.js$ {
    types { application/javascript js; }
    add_header Cache-Control "no-cache";
  }

  # /api PART AU SERVEUR DE JEU, il n'est jamais servi d'ici.
  #
  # Sans ce bloc, le `try_files ... /index.html` plus bas attrape /api/* et
  # rend la PAGE : le navigateur recoit du text/html la ou il attend du JSON,
  # `res.json()` jette, et le jeu s'arrete sur "NO CONNECTION" — avec un 200
  # dans les logs, ce qui ne ressemble a rien de casse. C'est le middleware
  # Next qui tenait ce role avant.
  #
  # L'amont est une VARIABLE, et c'est deliberé : ecrit en dur dans un
  # proxy_pass, nginx le resout AU DEMARRAGE et refuse de demarrer tant que le
  # conteneur de jeu n'ecoute pas — l'ordre de demarrage deviendrait une
  # dependance, et un redeploiement du serveur tuerait le web avec lui.
  #
  # Une variable oblige un resolver. Celui de Docker (127.0.0.11) resout les
  # noms de services ; il est configurable parce qu'il n'existe PAS sur le
  # reseau `bridge` par defaut, ou il donne un 502 plutot qu'une reponse.
  location /api/ {
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $amont "${API_UPSTREAM}";
    # L'hote de l'amont, sans le schema : l'en-tete Host et le SNI.
    set $amont_hote "${AMONT_HOTE}";
    proxy_pass $amont$request_uri;
    proxy_http_version 1.1;
    # L'amont peut etre en HTTPS derriere un reverse proxy mutualise : il lui
    # faut le SNI et un Host a SON nom, sinon il ne sait pas quel site servir
    # et repond une erreur de certificat ou la mauvaise application. $host
    # (rabbit.rip) ne lui dirait rien.
    proxy_ssl_server_name on;
    proxy_set_header Host $amont_hote;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Les routes lisent l'en-tete Authorization : Bearer, pas un cookie.
    proxy_pass_request_headers on;
  }

  # LE SOCKET, MEME AMONT, PLUS LA BASCULE WebSocket.
  #
  # Le client demande /api/config puis se connecte a `wsUrl` — et quand cette
  # valeur est vide il retombe sur `window.location.origin` (voir
  # use-game-socket.ts), donc sur CE serveur. Sans ce bloc, socket.io frappe un
  # 404 statique et le jeu reste sur l'ecran de connexion.
  #
  # Upgrade/Connection sont ce qui transforme la requete en WebSocket ; sans
  # eux nginx repond en HTTP ordinaire et la poignee de main echoue. Le
  # timeout long evite de couper une partie tranquille : par defaut nginx
  # ferme une connexion muette au bout d'une minute.
  location /socket.io/ {
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $amont_ws "${API_UPSTREAM}";
    set $amont_hote "${AMONT_HOTE}";
    proxy_pass $amont_ws$request_uri;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $amont_hote;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 1h;
    proxy_send_timeout 1h;
  }

  # Le HTML, jamais en cache : l'accueil a la racine, le jeu sous /play/.
  location = /index.html {
    add_header Cache-Control "no-cache";
  }
  location = /play/index.html {
    add_header Cache-Control "no-cache";
  }

  # /play et /pitch SANS barre finale doivent rediriger : servie telle quelle,
  # la page du jeu resoudrait `index.js` en /index.js (la racine) et resterait
  # noire. /pitch (le deck du demo day, landing/pitch/) suit la meme regle,
  # comme /terms et /privacy (les pages legales, landing/terms|privacy/).
  # /miracle1 et /miracle2 (la campagne theMiracle d'octobre 2026, cartes et
  # suisse) aussi.
  #
  # `absolute_redirect off` : nginx ecrirait sinon `http://<hote>:3010/play/`,
  # son port a lui, derriere le reverse proxy HTTPS de Coolify.
  location ~ ^/(play|pitch|terms|privacy|changelog|miracle1|miracle2)$ {
    absolute_redirect off;
    return 301 /$1/;
  }
  location ~ ^/(pitch|miracle1|miracle2)/index.html$ {
    add_header Cache-Control "no-cache";
  }

  # Les anciens liens vers le jeu a la racine (l'ecran d'accueil des PWA
  # installees avant l'accueil garde start_url "/" jusqu'a sa mise a jour) :
  # ils tombent sur l'accueil, a un clic du jeu. Rien a rediriger.

  location / {
    try_files $uri $uri/ /index.html;
  }
}


# LA VITRINE : rabbit.rip. Ses pages sont dans site/ ; l'art, les icones et
# les styles qu'elle partage avec l'accueil du web3 sont lus dans son arbre.
server {
  listen 3010;
  # WEB2_HOSTS : d'autres noms servis comme la vitrine (le stage :
  # stage.rabbit.rip). Vide en prod.
  server_name rabbit.rip www.rabbit.rip ${WEB2_HOSTS};
  root /usr/share/nginx/html/site;
  index index.html;

  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_types application/javascript text/css application/json image/svg+xml;

  # Le partage avec l'accueil du web3 : l'art (/assets/), les icones, et les
  # fichiers de l'ancienne PWA (sw.js, offline.html, manifest.json) qu'un
  # ecran d'accueil installe redemande encore.
  location ^~ /assets/ { root /usr/share/nginx/html/web3; }
  location ^~ /icons/ { root /usr/share/nginx/html/web3; }
  location ~ ^/(favicon\.ico|apple-touch-icon\.png|sw\.js|offline\.html|manifest\.json)$ {
    root /usr/share/nginx/html/web3;
  }

  # LES COQUES SEEKER : memes fichiers et memes regles de cache que sur le
  # site du web3 (voir le premier serveur).
  location = /play/android/manifest.json {
    root /usr/share/nginx/html/web3;
    types { application/json json; }
    add_header Cache-Control "no-cache";
  }
  location ~ "^/play/android/game-[0-9a-f]{64}\.pck$" {
    root /usr/share/nginx/html/web3;
    types { application/octet-stream pck; }
    gzip off;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
  location ^~ /play/voice/ { root /usr/share/nginx/html/web3; }
  location ~ ^/play/(firebase-messaging-sw|firebase-config)\.js$ {
    root /usr/share/nginx/html/web3;
    types { application/javascript js; }
    add_header Cache-Control "no-cache";
  }

  # LE JEU WEB2 (2026-10-30), memes regles que le jeu du web3 : les gros
  # fichiers compresses au build et revalides, la page et move.js jamais en
  # cache. Le reste de /play/ retombe sur la page du jeu.
  location ~ ^/play/index\.(wasm|pck|js|audio\.worklet\.js|audio\.position\.worklet\.js)$ {
    types {
      application/wasm wasm;
      application/octet-stream pck;
      application/javascript js;
    }
    gzip_static on;
    add_header Cache-Control "no-cache";
  }
  location ~ ^/play/(index\.html|move\.js)?$ {
    try_files $uri /play/index.html;
    add_header Cache-Control "no-cache";
  }
  location /play/ {
    try_files $uri /play/index.html;
  }

  # Ce qui n'appartient qu'au web3 garde ses anciens liens (deck envoye aux
  # investisseurs, campagne theMiracle, changelog ouvert par le jeu) : ils
  # suivent, sans que la vitrine ne les lie nulle part.
  location ~ ^/(pitch|miracle1|miracle2|changelog)(/.*)?$ {
    return 301 https://sol.rabbit.rip$request_uri;
  }

  # Sans barre finale, comme sur l'autre site : une page servie telle quelle
  # resoudrait ses liens relatifs a la racine.
  location ~ ^/(play|support|privacy|terms|legal|delete-account)$ {
    absolute_redirect off;
    return 301 /$1/;
  }

  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
