# RR-ADMIN — the back office (admin/server.ts), apart from the game server.
#
# One binary, like rr-ws: Bun compiles runtime + code + deps. It only needs
# admin/ (and drizzle-orm/postgres from the lockfile) — no game code, no keys.
#
#   docker build -f Dockerfile.admin -t rr-admin .
#
# Env: see admin/server.ts. Site (Coolify, admin.rabbit.rip): DATABASE_URL,
# JWT_SIGNING_SECRET, ADMIN_TOTP_SECRET, ADMIN_REGION=eu, ADMIN_PEERS. Agent
# (deploy/region): DATABASE_URL, JWT_SIGNING_SECRET, WS_DOMAIN. Port 3020.
FROM oven/bun:1-alpine AS build
WORKDIR /app
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile
COPY tsconfig.json ./
COPY admin ./admin
RUN bun build admin/server.ts --compile --minify --outfile rr-admin

FROM alpine:3
WORKDIR /app
RUN apk add --no-cache libstdc++ libgcc wget
COPY --from=build /app/rr-admin ./rr-admin
ENV ADMIN_PORT=3020
EXPOSE 3020
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:3020/health || exit 1
USER nobody
CMD ["./rr-admin"]
