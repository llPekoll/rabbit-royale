# TLS for the region, Let's Encrypt on first request. WebSockets pass through
# reverse_proxy as is — socket.io's upgrade needs nothing more.
{$WS_DOMAIN} {
	encode gzip
	# The back office's agent (rr-admin), from its own repo
	# (rabbit-royale-admin, compose project rabbit-admin on this network):
	# only admin.rabbit.rip calls it. Everything else is the game.
	handle /admin-agent/* {
		reverse_proxy rr-admin:3020
	}
	handle {
		reverse_proxy rr-ws:3010
	}
}
