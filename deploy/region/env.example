# Copy to /opt/rabbit/.env on the region's VPS. NEVER commit the real file.
# DATABASE_URL, REDIS_URL and WS_PORT are set by compose.yml — not here.

# This region's public host, pointed at the VPS by an A record.
#   ws-sg.rabbit.rip   ws-us.rabbit.rip
WS_DOMAIN=

# The web2 world's host on the same VPS:  ws2-sg.rabbit.rip   ws2-us.rabbit.rip
WS2_DOMAIN=

# `openssl rand -hex 24`. Only rr-ws ever connects; Postgres has no public port.
POSTGRES_PASSWORD=

# Its OWN secret (`openssl rand -hex 32`): a token from another region must not
# open an account here — the accounts are not the same.
JWT_SIGNING_SECRET=

# Payments: the same treasury as Europe is fine. A purchase is bound to ONE
# region's quote by the memo reference, so it can only be credited once.
USDC_TREASURY_ADDRESS=
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SKR_MINT=
SOLANA_RPC_URL=

# Push: the same Firebase project as Europe (the app is the same app).
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# Alerte Discord (#payment-alerts) a chaque paiement rate : URL du webhook,
# dans ~/.config/rabbit-royale/pay-alert-webhook. Absente = rien ne part.
PAY_ALERT_WEBHOOK=

# THE WEB2 WORLD (compose: postgres-web2, rr-ws-web2). Its own base and its
# OWN secret — never the web3 one. Firebase is shared (same app).
WEB2_POSTGRES_PASSWORD=
WEB2_JWT_SIGNING_SECRET=
# Google sign-in and email codes (both worlds read them).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JENVOIE_API_KEY=
