<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ : la permission notifications se demande à l'exécution,
         une déclaration seule ne suffit pas (voir MainActivity). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Le Mobile Wallet Adapter cherche un wallet par intent ; sans cette
         déclaration, Android 11+ le cache et le login échoue en
         "NoWalletFound" sur un appareil qui en a pourtant un. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="solana-wallet" />
        </intent>
    </queries>

    <!-- hardwareAccelerated est declare EXPLICITEMENT, aux deux niveaux.
         Le defaut d'Android est certes true au-dessus de targetSdk 14, mais
         c'est un defaut que des surcouches constructeur et les modes
         d'economie de batterie retrogradent sans le dire. Une WebView
         retrogradee perd WebGL et Pixi tombe sur un chemin CPU, ou chaque
         texture passe par le processeur.
         Ce n'etait PAS la cause de la lenteur au demarrage (la sonde de
         MainActivity mesure Mali-G615, webgl2=true, LOGICIEL=false sur un
         Seeker) : c'est une ceinture, pas un correctif. Un jeu WebGL ne peut
         pas laisser ce point a un defaut implicite. -->

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RabbitRoyale"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
