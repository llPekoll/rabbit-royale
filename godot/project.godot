; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rabbit Royale"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/rr-logo-1x.webp"

[autoload]

I18N="*res://scripts/i18n.gd"
Net="*res://scripts/net.gd"
Wallet="*res://scripts/wallet.gd"
Session="*res://scripts/session.gd"
GameSocket="*res://scripts/game_socket.gd"
; Les nombres de tuning.ts, et le terrier du joueur. Home lit Session, Net,
; I18N et Tuning : il vient apres eux.
Tuning="*res://scripts/tuning.gd"
Home="*res://scripts/home.gd"
Screens="*res://scripts/screens.gd"
; Le marqueur de cadence, visible partout et tout le temps. Un autoload parce
; qu'il doit survivre aux traversees ; apres Screens parce qu'il se dessine
; par-dessus tout ce que Screens monte.
FpsMarker="*res://scripts/fps_marker.gd"

[display]

window/size/viewport_width=890
window/size/viewport_height=400
; MAXIMISEE sur PC : 890x400 est la taille de reference (un telephone couche),
; pas la taille de la fenetre. Les ecrans se recadrent a la taille reelle
; (size_changed), donc la fenetre peut remplir l'ecran. Ignore sur Android.
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; ⚠ `window/stretch/scale` N'EST PAS UN REGLAGE DE RESOLUTION DE RENDU.
;
; Essaye ici pour baisser le cout fragment : il AGRANDIT le canevas de design
; (890x400 -> 1780x800) au lieu de rasteriser plus gros. Sur le Seeker, le jeu
; s'est retrouve dans un quart de l'ecran avec un chrome minuscule.
;
; LE COUT EST REEL POURTANT : `canvas_items` dessine en coordonnees de design
; mais rasterise a la resolution de l'ECRAN — 2670x1200 sur le Seeker, soit
; NEUF FOIS les 890x400 du canevas. Tout shader plein ecran paie ces 3,2
; millions de fragments.
;
; LA BONNE REPONSE EST UN SubViewport, comme `fx_bench` le fait deja pour son
; voile (RENDER_SCALE = 0,5, « un rai est trop flou pour qu'on le voie ») : on
; rend l'effet dans une texture plus petite et on l'agrandit en nearest. A
; brancher dans `sky_light.gd` le jour ou le budget se resserre — aujourd'hui
; le bruit cuit a suffi (21 -> 82 fps).

[editor_plugins]

enabled=PackedStringArray("res://addons/RabbitMWA/plugin.cfg")

[gui]

theme/custom="res://assets/ui/theme.tres"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.051, 0.067, 0.09, 1)
