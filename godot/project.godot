; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rabbit Royale"
; LA RACINE, et non l'accueil : Main.tscn ne se recharge jamais et porte les
; ecrans (voir scripts/screens.gd). Lancer title.tscn directement ferait de
; l'accueil la racine, et changer d'ecran le detruirait avec tout ce qu'il
; tient.
run/main_scene="res://scenes/sky_tuner.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/rr-logo-1x.webp"

[autoload]

I18N="*res://scripts/i18n.gd"
Net="*res://scripts/net.gd"
Wallet="*res://scripts/wallet.gd"
Session="*res://scripts/session.gd"
GameSocket="*res://scripts/game_socket.gd"
; Le routeur d'ecrans. En dernier : il ne depend de rien, et tout le reste
; peut l'appeler.
Screens="*res://scripts/screens.gd"

[display]

window/size/viewport_width=890
window/size/viewport_height=400
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/RabbitMWA/plugin.cfg")

[gui]

theme/custom="res://assets/ui/theme.tres"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.051, 0.067, 0.09, 1)
