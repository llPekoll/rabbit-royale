[gd_scene load_steps=8 format=3]

; L'ILE. Le second des deux lieux residents — construite une fois, jamais
; liberee, montree ou cachee (voir screens.gd).
;
; MEME ORDRE DE DESSIN QUE LE TERRIER, et ce n'est pas de la paresse : les deux
; plateaux partagent le renderer (le web les fait passer tous les deux par
; IsoIslandView), et c'est ce qui garantit qu'une correction de tri profite aux
; deux. Ce qui change entre eux tient dans la carte : 32x32 a trois paliers ici,
; 19x19 a deux la-bas.
;
; CE QUI N'EST PAS ENCORE LA : le brouillard, les chiffres, les coffres —
; l'etat par case (Tile.ts, 74 Ko sans equivalent terrier). Le socle d'abord,
; mesure ; le reste se posera dans ces memes blocs.

[ext_resource type="Script" path="res://scripts/island.gd" id="1_island"]
[ext_resource type="Script" path="res://scripts/burrow_terrain.gd" id="2_terrain"]
[ext_resource type="Script" path="res://scripts/placement_hints.gd" id="3_hints"]
[ext_resource type="PackedScene" path="res://scenes/ocean.tscn" id="4_ocean"]
[ext_resource type="Script" path="res://scripts/sky_light.gd" id="8_sky"]
[ext_resource type="Script" path="res://scripts/tile_view.gd" id="9_tiles"]
[ext_resource type="Script" path="res://scripts/island_rabbit.gd" id="10_rabbit"]
[ext_resource type="Script" path="res://scripts/move_ring.gd" id="11_ring"]

[node name="Island" type="Node2D"]
script = ExtResource("1_island")

[node name="Terrain" type="Node2D" parent="."]
unique_name_in_owner = true
script = ExtResource("2_terrain")

; LA MER ET CE QUI Y VIT — degrade, ecume, rochers, canards : une scene,
; la meme qu'au terrier (ocean.tscn). APRES le terrain dans l'arbre : a
; profondeur egale, un canard au sud d'une case de terre passe devant elle.
; Ce sont les `z_index` (Iso.depth) qui trient vraiment, pas les couches.
[node name="Ocean" parent="." instance=ExtResource("4_ocean")]
unique_name_in_owner = true

; LE JOUEUR. Le meme lapin qu'au terrier — meme planche, meme saut — mais il
; n'erre pas (`roam = false` dans island.gd) : ici il se tient ou on l'a mene.
; FRERE du terrain, pas enfant, pour se trier contre les tuiles sur leur regle.
[node name="Rabbit" type="Node2D" parent="."]
unique_name_in_owner = true
script = ExtResource("10_rabbit")

; LES LOSANGES DE PLACEMENT. Ce noeud ne porte RIEN lui-meme : chaque losange
; est monte dans le bloc de sa case, sous le terrain, pour se trier avec le sol
; qu'il recouvre. Il n'est qu'un chef d'orchestre.
[node name="Hints" type="Node2D" parent="."]
unique_name_in_owner = true
script = ExtResource("3_hints")

; LA LUMIERE DU CIEL — les ombres de nuages, puis les rais entre elles.
;
; ENFANT DE L'ILE, contrairement a la mer, et c'est le contraire du meme
; raisonnement : la mer est un eclairage de fond qui reste sous l'ecran, une
; ombre de nuage est posee SUR le terrain a un endroit du monde et doit glisser
; avec lui. Le web fait pareil — son plan de rais est ajoute au conteneur de la
; camera, pas au stage.
;
; Les deux couches lisent LE MEME bruit avec LES MEMES reglages : une ombre est
; un trou dans la couverture vu d'en dessous, un rai le meme trou vu de cote.
[node name="Sky" type="Node2D" parent="."]
unique_name_in_owner = true
script = ExtResource("8_sky")

; L'ETAT DES CASES — le voile et les chiffres.
;
; Ce noeud ne porte RIEN lui-meme : chaque voile et chaque chiffre est monte
; dans le BLOC de sa case, sous le terrain, pour se trier avec le sol qu'il
; recouvre. Un voile pose en frere libre se trierait entre deux profondeurs et
; un plateau en terrasses le montrerait au-dessus de la mauvaise tuile.
[node name="Tiles" type="Node2D" parent="."]
unique_name_in_owner = true
script = ExtResource("9_tiles")

; L'ANNEAU D'OR — les cases qu'un pas peut atteindre. Meme montage que les
; voiles : deux sprites par case, dans le bloc de la case, pour se trier avec
; le sol. Le noeud n'est qu'un chef d'orchestre du balayage.
[node name="Ring" type="Node2D" parent="."]
unique_name_in_owner = true
script = ExtResource("11_ring")
