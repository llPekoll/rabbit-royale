[gd_scene format=3]

; LE CHROME — voir scripts/chrome.gd pour ce que chaque etage porte.
;
; Tous les conteneurs sont IGNORE au pointeur (mouse_filter = 2) : ils
; couvrent l'ecran et ne doivent voler aucun clic destine au sol. Les
; panneaux qu'ils portent reprennent les leurs.

[ext_resource type="Script" path="res://scripts/chrome.gd" id="1_chrome"]

[node name="Chrome" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_chrome")

[node name="Column" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 9
anchor_bottom = 1.0
grow_vertical = 2
mouse_filter = 2

[node name="Floor" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2

[node name="TopBar" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2
mouse_filter = 2

[node name="Toasts" type="VBoxContainer" parent="."]
